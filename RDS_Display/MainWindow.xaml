<Window x:Class="RDS_Display.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RDS Display"
        Height="760"
        Width="1100"
        MinHeight="520"
        MinWidth="800"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource InkBrush}"
        FontFamily="Segoe UI"
        FontSize="14">
    <DockPanel Margin="16">
        <Border DockPanel.Dock="Top"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12,10"
                Margin="0,0,0,12">
            <DockPanel>
                <TextBlock x:Name="StatusText"
                           DockPanel.Dock="Right"
                           Margin="16,0,0,0"
                           VerticalAlignment="Center"
                           TextAlignment="Right"
                           TextWrapping="Wrap"
                           MaxWidth="420"
                           Foreground="{StaticResource MutedBrush}"
                           Text="Starting"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="Listen port" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                        <TextBox x:Name="PortBox" Width="90" Margin="0,4,0,0" Text="9100" LostFocus="Endpoint_LostFocus"/>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Mode" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                        <TextBlock x:Name="ModeText" Margin="0,4,0,0" FontWeight="SemiBold" Text="Bib reads"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid>
            <Grid x:Name="WelcomeStage" Visibility="Collapsed">
                <Image Source="/banner.png" Stretch="UniformToFill"/>
                <Border VerticalAlignment="Bottom" Background="#99070B10" Padding="36,28">
                    <StackPanel>
                        <TextBlock x:Name="WelcomeTitle"
                                   Text="Welcome"
                                   FontSize="48"
                                   FontWeight="Bold"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="WelcomeDetail"
                                   Margin="0,8,0,0"
                                   FontSize="22"
                                   Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap"
                                   Text="Race day"/>
                        <Grid Margin="0,16,0,0">
                            <TextBlock x:Name="WelcomeWeather"
                                       FontSize="16"
                                       Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap"
                                       Text="Waiting for RDS"/>
                            <TextBlock x:Name="WelcomeClock"
                                       FontSize="16"
                                       HorizontalAlignment="Right"
                                       TextAlignment="Right"
                                       Foreground="{StaticResource MutedBrush}"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
            <Grid x:Name="EventWelcomeStage" Visibility="Collapsed" Background="#071533">
                <Viewbox Stretch="Uniform">
                    <Grid Width="1920" Height="1080">
                        <Image x:Name="EventImage" Stretch="UniformToFill"/>
                        <Grid x:Name="EventChrome">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="56.5*"/>
                                <RowDefinition Height="4.5*"/>
                                <RowDefinition Height="18*"/>
                                <RowDefinition Height="21*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40.8*"/>
                                <ColumnDefinition Width="29.6*"/>
                                <ColumnDefinition Width="29.6*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.ColumnSpan="3" VerticalAlignment="Bottom" Margin="64,0,64,36">
                                <TextBlock x:Name="EventTitle"
                                           Text="Event welcome"
                                           FontSize="64"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           TextWrapping="Wrap"/>
                                <TextBlock x:Name="EventHint"
                                           Margin="0,12,0,0"
                                           FontSize="28"
                                           Foreground="#D6E8F8"
                                           TextWrapping="Wrap"/>
                                <TextBlock x:Name="EventUrl"
                                           Margin="0,8,0,0"
                                           FontSize="24"
                                           Foreground="#F5C518"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <Border Grid.Row="1" Grid.Column="1" Background="#F5C518">
                                <TextBlock Text="RACE STARTS AT"
                                           FontWeight="Bold"
                                           FontSize="28"
                                           Foreground="#071533"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="2" Background="#F5C518">
                                <TextBlock Text="TIME UNTIL START"
                                           FontWeight="Bold"
                                           FontSize="28"
                                           Foreground="#071533"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <Border Grid.Row="2" Grid.Column="1" Background="#071533"/>
                            <Border Grid.Row="2" Grid.Column="2" Background="#071533"/>
                            <Border Grid.Row="1" Grid.Column="2" Width="6" HorizontalAlignment="Left"
                                    Grid.RowSpan="2" Background="#F5C518"/>
                        </Grid>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="61*"/>
                                <RowDefinition Height="18*"/>
                                <RowDefinition Height="21*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40.8*"/>
                                <ColumnDefinition Width="29.6*"/>
                                <ColumnDefinition Width="29.6*"/>
                            </Grid.ColumnDefinitions>
                            <Viewbox Grid.Row="1" Grid.Column="1" Margin="48,20" Stretch="Uniform">
                                <TextBlock x:Name="EventGunTimeText"
                                           Text="—"
                                           FontWeight="Bold"
                                           FontSize="72"
                                           Foreground="White"/>
                            </Viewbox>
                            <Viewbox Grid.Row="1" Grid.Column="2" Margin="48,20" Stretch="Uniform">
                                <TextBlock x:Name="EventCountdownText"
                                           Text="—"
                                           FontWeight="Bold"
                                           FontSize="72"
                                           Foreground="White"/>
                            </Viewbox>
                        </Grid>
                    </Grid>
                </Viewbox>
            </Grid>
            <DockPanel x:Name="BoardStage" Visibility="Collapsed">
                <TextBlock x:Name="BoardTitle"
                           DockPanel.Dock="Top"
                           FontSize="36"
                           FontWeight="Bold"
                           Margin="8,0,8,12"
                           Text="Scrolling results"/>
                <Grid x:Name="BoardHeader" DockPanel.Dock="Top" Margin="8,0,8,8"/>
                <ScrollViewer x:Name="BoardScroller"
                              VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="BoardLines"/>
                </ScrollViewer>
            </DockPanel>
            <DockPanel x:Name="ReadsStage">
                <Border DockPanel.Dock="Top"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="20,16"
                        Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="FeaturedBib"
                                   Text="—"
                                   FontSize="72"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,24,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="FeaturedName"
                                       Text="Waiting for a bib read."
                                       FontSize="32"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="FeaturedDetail"
                                       Margin="0,8,0,0"
                                       FontSize="20"
                                       Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <DataGrid x:Name="ReadsGrid">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Read" Binding="{Binding ReadTime}" Width="90"/>
                        <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="120"/>
                        <DataGridTextColumn Header="Bib" Binding="{Binding Bib}" Width="80"/>
                        <DataGridTextColumn Header="Chip" Binding="{Binding Chip}" Width="90"/>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="200"/>
                        <DataGridTextColumn Header="Finish" Binding="{Binding FinishTime}" Width="110"/>
                        <DataGridTextColumn Header="Place" Binding="{Binding Place}" Width="70"/>
                        <DataGridTextColumn Header="Event" Binding="{Binding EventName}" Width="160"/>
                        <DataGridTextColumn Header="City" Binding="{Binding City}" Width="120"/>
                        <DataGridTextColumn Header="State" Binding="{Binding State}" Width="70"/>
                        <DataGridTextColumn Header="Clock" Binding="{Binding ClockTime}" Width="110"/>
                        <DataGridTextColumn Header="Pace" Binding="{Binding Pace}" Width="80"/>
                        <DataGridTextColumn Header="Division" Binding="{Binding Division}" Width="140"/>
                        <DataGridTextColumn Header="Div place" Binding="{Binding DivisionPlace}" Width="90"/>
                        <DataGridTextColumn Header="Age group" Binding="{Binding AgeGroup}" Width="110"/>
                        <DataGridTextColumn Header="Gender" Binding="{Binding Gender}" Width="80"/>
                        <DataGridTextColumn Header="Age" Binding="{Binding Age}" Width="60"/>
                        <DataGridTextColumn Header="Team" Binding="{Binding Team}" Width="140"/>
                        <DataGridTextColumn Header="Report" Binding="{Binding Report}" Width="180"/>
                        <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="180"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
            <Border x:Name="ModeStage"
                    Visibility="Collapsed"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="40">
                    <TextBlock x:Name="ModeTitle"
                               Text="Welcome"
                               FontSize="64"
                               FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="ModeDetail"
                               Margin="0,16,0,0"
                               FontSize="24"
                               Foreground="{StaticResource MutedBrush}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Text="Waiting for the race welcome screen."/>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
