<Window x:Class="RDS_Display.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RDS Display"
        Height="760"
        Width="1100"
        MinHeight="520"
        MinWidth="800"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource InkBrush}"
        FontFamily="Segoe UI"
        FontSize="14">
    <DockPanel Margin="16">
        <Border DockPanel.Dock="Top"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12,10"
                Margin="0,0,0,12">
            <DockPanel>
                <TextBlock x:Name="StatusText"
                           DockPanel.Dock="Right"
                           Margin="16,0,0,0"
                           VerticalAlignment="Center"
                           TextAlignment="Right"
                           TextWrapping="Wrap"
                           MaxWidth="420"
                           Foreground="{StaticResource MutedBrush}"
                           Text="Starting"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Host" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                        <TextBox x:Name="HostBox" Width="180" Margin="0,4,0,0" Text="127.0.0.1" LostFocus="Endpoint_LostFocus"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Port" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                        <TextBox x:Name="PortBox" Width="90" Margin="0,4,0,0" Text="9100" LostFocus="Endpoint_LostFocus"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Top"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="20,16"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="FeaturedBib"
                           Text="—"
                           FontSize="72"
                           FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,24,0"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="FeaturedName"
                               Text="Waiting for a bib read."
                               FontSize="32"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="FeaturedDetail"
                               Margin="0,8,0,0"
                               FontSize="20"
                               Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

        <DataGrid x:Name="ReadsGrid">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Read" Binding="{Binding ReadTime}" Width="90"/>
                <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="120"/>
                <DataGridTextColumn Header="Bib" Binding="{Binding Bib}" Width="80"/>
                <DataGridTextColumn Header="Chip" Binding="{Binding Chip}" Width="90"/>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="200"/>
                <DataGridTextColumn Header="Finish" Binding="{Binding FinishTime}" Width="110"/>
                <DataGridTextColumn Header="Place" Binding="{Binding Place}" Width="70"/>
                <DataGridTextColumn Header="Event" Binding="{Binding EventName}" Width="160"/>
                <DataGridTextColumn Header="City" Binding="{Binding City}" Width="120"/>
                <DataGridTextColumn Header="State" Binding="{Binding State}" Width="70"/>
                <DataGridTextColumn Header="Clock" Binding="{Binding ClockTime}" Width="110"/>
                <DataGridTextColumn Header="Pace" Binding="{Binding Pace}" Width="80"/>
                <DataGridTextColumn Header="Division" Binding="{Binding Division}" Width="140"/>
                <DataGridTextColumn Header="Div place" Binding="{Binding DivisionPlace}" Width="90"/>
                <DataGridTextColumn Header="Age group" Binding="{Binding AgeGroup}" Width="110"/>
                <DataGridTextColumn Header="Gender" Binding="{Binding Gender}" Width="80"/>
                <DataGridTextColumn Header="Age" Binding="{Binding Age}" Width="60"/>
                <DataGridTextColumn Header="Team" Binding="{Binding Team}" Width="140"/>
                <DataGridTextColumn Header="Report" Binding="{Binding Report}" Width="180"/>
                <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="180"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
