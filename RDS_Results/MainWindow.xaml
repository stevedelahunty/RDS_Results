<Window x:Class="RDS_Results.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RDS_Results"
        Title="RDS Results"
        Height="940"
        Width="1440"
        MinHeight="760"
        MinWidth="1100"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource InkBrush}"
        FontFamily="Segoe UI"
        FontSize="13">
    <DockPanel Margin="14">
        <Border x:Name="HubBanner"
                DockPanel.Dock="Top"
                AutomationProperties.AutomationId="HubBanner"
                Visibility="Collapsed"
                Background="{DynamicResource GoldBrush}"
                CornerRadius="10"
                Padding="22,16"
                Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Start the RaceDay Hub in RaceDay Scoring"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="{DynamicResource GoldInkBrush}"
                           TextWrapping="Wrap"/>
                <TextBlock Margin="0,6,0,0"
                           FontSize="16"
                           Foreground="{DynamicResource GoldInkBrush}"
                           TextWrapping="Wrap"
                           Text="The connection is being refused. That means the hub is not enabled. Start the RaceDay Hub in RDS, and this screen will connect on the next refresh."/>
            </StackPanel>
        </Border>
        <Border DockPanel.Dock="Top" Margin="0,0,0,10" Background="#031422" BorderBrush="#16324A" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="76"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Image Source="/banner.png" Stretch="Fill"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,12,0">
                        <Button x:Name="ResultsViewButton" AutomationProperties.AutomationId="ResultsView" Style="{StaticResource PillButton}" Click="ResultsViewButton_Click" Content="Results"/>
                        <Button x:Name="ReadsViewButton" AutomationProperties.AutomationId="ReadsView" Style="{StaticResource PillButton}" Click="ReadsViewButton_Click" Content="Bib reads"/>
                        <Button x:Name="SettingsViewButton" AutomationProperties.AutomationId="SettingsView" Style="{StaticResource PillButton}" Margin="0" Click="SettingsViewButton_Click" Content="Settings"/>
                    </StackPanel>
                </Grid>
                <Border Grid.Row="1" Background="#071018" Padding="14,8" BorderBrush="#123044" BorderThickness="0,1,0,0">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="1.15*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="1.7*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                            <Viewbox Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Path Data="{x:Static local:Marks.Pin}" Fill="#D6E8F8" Stretch="Uniform"/>
                            </Viewbox>
                            <StackPanel>
                                <TextBlock x:Name="RaceTitleText" FontWeight="SemiBold" Foreground="#F4F8FC" TextTrimming="CharacterEllipsis" Text="Waiting for RaceDay"/>
                                <TextBlock x:Name="RaceMetaText" Margin="0,1,0,0" FontSize="12" Foreground="#8FB4D4" TextTrimming="CharacterEllipsis" Text="Event ID loads with the race."/>
                            </StackPanel>
                        </StackPanel>
                        <Border Grid.Column="1" Width="1" Height="28" Background="#3A5A78" Margin="2,0,14,0" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                            <Viewbox Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Path Data="{x:Static local:Marks.Calendar}" Fill="#D6E8F8" Stretch="Uniform"/>
                            </Viewbox>
                            <StackPanel>
                                <TextBlock x:Name="DateStartText" FontWeight="SemiBold" Foreground="#F4F8FC" Text="—"/>
                                <TextBlock x:Name="DateEndText" Margin="0,1,0,0" FontSize="12" Foreground="#8FB4D4" Text=""/>
                            </StackPanel>
                        </StackPanel>
                        <Border Grid.Column="3" Width="1" Height="28" Background="#3A5A78" Margin="0,0,14,0" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                            <Viewbox Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Path Data="{x:Static local:Marks.Runner}" Fill="#D6E8F8" Stretch="Uniform"/>
                            </Viewbox>
                            <StackPanel>
                                <TextBlock x:Name="ReportCountText" FontWeight="SemiBold" Foreground="#F4F8FC" TextTrimming="CharacterEllipsis" Text="0 Reports Detected"/>
                                <TextBlock x:Name="StatusText" Margin="0,1,0,0" FontSize="12" Foreground="#8FB4D4" TextTrimming="CharacterEllipsis" Text="Starting"/>
                            </StackPanel>
                        </StackPanel>
                        <Border Grid.Column="5" Width="1" Height="28" Background="#3A5A78" Margin="0,0,14,0" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="6" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock x:Name="EventsText" FontWeight="SemiBold" Foreground="#F4F8FC" TextTrimming="CharacterEllipsis" Text="Distance loads with the race."/>
                            <TextBlock x:Name="PollText" Margin="0,1,0,0" FontSize="12" Foreground="#8FB4D4" TextTrimming="CharacterEllipsis" Text="Waiting for the first poll"/>
                        </StackPanel>
                        <Border Grid.Column="7" Width="1" Height="28" Background="#3A5A78" Margin="0,0,14,0" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="8" Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="ConnectionDot" Width="8" Height="8" Fill="{DynamicResource WarnBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ConnectionText"
                                       Foreground="#F4F8FC"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="Connecting to RaceDay Scoring"
                                       Text="Connecting to RaceDay Scoring"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid>
            <DockPanel x:Name="ResultsBoard">
                <UniformGrid DockPanel.Dock="Top" Columns="4" Margin="0,0,0,10">
                    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,8,0">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="32" Height="32" CornerRadius="16" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5" Margin="0,0,10,0" VerticalAlignment="Center">
                                <TextBlock Text="iR" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel>
                            <TextBlock Text="iResultsLIVE" FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource WarnBrush}" Margin="0,0,6,0"/>
                                <TextBlock Text="Not set up" Foreground="{DynamicResource MutedBrush}"/>
                            </StackPanel>
                            <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource MutedBrush}" Text="No iResults connection yet." TextWrapping="Wrap"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,8,0">
                        <DockPanel>
                            <Viewbox DockPanel.Dock="Left" Width="30" Height="30" Margin="0,0,10,0" VerticalAlignment="Center">
                                <Path Data="{x:Static local:Marks.Monitor}" Fill="{DynamicResource AccentBrush}" Stretch="Uniform"/>
                            </Viewbox>
                            <StackPanel>
                            <TextBlock Text="Jumbotron" FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Ellipse x:Name="JumboDot" Width="8" Height="8" Fill="{DynamicResource WarnBrush}" Margin="0,0,6,0"/>
                                <TextBlock x:Name="JumboStateText" Text="Waiting"/>
                            </StackPanel>
                            <TextBlock x:Name="JumboDetailText" Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Text="Bib reads stay on this computer until sending starts."/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,8,0">
                        <DockPanel>
                            <Viewbox DockPanel.Dock="Left" Width="30" Height="30" Margin="0,0,10,0" VerticalAlignment="Center">
                                <Path Data="{x:Static local:Marks.Kiosk}" Fill="{DynamicResource AccentBrush}" Stretch="Uniform"/>
                            </Viewbox>
                            <StackPanel>
                            <TextBlock Text="On-Site Kiosk" FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource WarnBrush}" Margin="0,0,6,0"/>
                                <TextBlock Text="Not set up" Foreground="{DynamicResource MutedBrush}"/>
                            </StackPanel>
                            <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource MutedBrush}" Text="No kiosk connection yet." TextWrapping="Wrap"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                        <DockPanel>
                            <Viewbox DockPanel.Dock="Left" Width="30" Height="30" Margin="0,0,10,0" VerticalAlignment="Center">
                                <Path Data="{x:Static local:Marks.Printer}" Fill="{DynamicResource AccentBrush}" Stretch="Uniform"/>
                            </Viewbox>
                            <StackPanel>
                            <TextBlock Text="Print System" FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource WarnBrush}" Margin="0,0,6,0"/>
                                <TextBlock Text="Not set up" Foreground="{DynamicResource MutedBrush}"/>
                            </StackPanel>
                            <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource MutedBrush}" Text="No printer connection yet." TextWrapping="Wrap"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </UniformGrid>

                <Grid DockPanel.Dock="Bottom" Height="210" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.45*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="0.72*"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Jumbotron" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBlock DockPanel.Dock="Bottom"
                                       x:Name="PreviewText"
                                       Margin="0,8,0,0"
                                       FontSize="11"
                                       Foreground="{DynamicResource MutedBrush}"
                                       TextWrapping="Wrap"
                                       Text="No display client connected."/>
                            <Border Background="{DynamicResource InputBrush}" CornerRadius="6">
                                <TextBlock Text="Camera preview appears here when an RTSP address is set."
                                           Foreground="{DynamicResource MutedBrush}"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Margin="16"/>
                            </Border>
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right"
                                        Content="Clear"
                                        Style="{StaticResource PillButton}"
                                        Padding="10,2"
                                        FontSize="12"
                                        Margin="0"
                                        Click="ClearActivityButton_Click"/>
                                <TextBlock Text="System Activity" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBox x:Name="ActivityBox"
                                     IsReadOnly="True"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Foreground="{DynamicResource MutedBrush}"
                                     FontSize="12"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     AcceptsReturn="True"/>
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Event Statistics" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <UniformGrid Columns="2" Rows="2">
                                <StackPanel Margin="0,0,8,8">
                                    <TextBlock x:Name="StatReports" FontSize="22" FontWeight="Bold" Text="0"/>
                                    <TextBlock Text="Reports" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock x:Name="StatFinishers" FontSize="22" FontWeight="Bold" Text="0"/>
                                    <TextBlock Text="Finishers" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock x:Name="StatDisplays" FontSize="22" FontWeight="Bold" Text="0"/>
                                    <TextBlock Text="Displays" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock x:Name="StatWaiting" FontSize="22" FontWeight="Bold" Text="0"/>
                                    <TextBlock Text="Waiting" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                                </StackPanel>
                            </UniformGrid>
                        </DockPanel>
                    </Border>
                </Grid>
                <Grid x:Name="BoardHost" ClipToBounds="True" SizeChanged="BoardScroller_SizeChanged">
                    <TextBlock x:Name="EmptyStateText"
                               Margin="8"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Foreground="{DynamicResource MutedBrush}"
                               Text="No reports are available yet. In RaceDay Scoring, make a report available via the kiosk."/>
                    <ItemsControl x:Name="ReportSections" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="1"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                <Setter Property="VerticalAlignment" Value="Stretch"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                    </ItemsControl>
                </Grid>
            </DockPanel>

            <Grid x:Name="ReadsBoard" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,8">
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock DockPanel.Dock="Right"
                                   x:Name="ReadStatusText"
                                   Foreground="{DynamicResource MutedBrush}"
                                   VerticalAlignment="Center"
                                   Text="Not listening"/>
                        <TextBlock Text="Locations" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock x:Name="LocationEmptyText"
                               Margin="0,4,0,0"
                               Foreground="{DynamicResource MutedBrush}"
                               Text="Locations appear here after the listener connects."/>
                    <ItemsControl x:Name="LocationChoices" Margin="0,4,0,8">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Name}"
                                          IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Margin="0,0,16,4"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <Border Grid.Row="1"
                        Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource LineBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="8">
                    <ContentControl x:Name="ReadsHost"/>
                </Border>
            </Grid>
            <ScrollViewer x:Name="SettingsBoard" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"/>
        </Grid>
    </DockPanel>
</Window>
