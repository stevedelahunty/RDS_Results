<ResourceDictionary x:Class="RDS_Results.GridStyles"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="RowBackground" Value="{DynamicResource PanelBrush}"/>
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource GridAltBrush}"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource GridLineBrush}"/>
        <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource GridLineBrush}"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserResizeRows" Value="False"/>
        <Setter Property="AutoGenerateColumns" Value="True"/>
        <Setter Property="EnableRowVirtualization" Value="True"/>
        <Setter Property="EnableColumnVirtualization" Value="True"/>
        <Setter Property="SelectionMode" Value="Extended"/>
        <Setter Property="SelectionUnit" Value="FullRow"/>
        <Setter Property="RowHeaderWidth" Value="0"/>
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource GridHeaderBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GridLineBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="6,2"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource AccentInkBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGridRow">
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource AccentInkBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <DataTemplate x:Key="ReportSectionTemplate">
        <Border Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="1"
                CornerRadius="8"
                ClipToBounds="True"
                Margin="4"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <DockPanel>
                <Border DockPanel.Dock="Top" Height="4" Background="{Binding Accent}"/>
                <Grid DockPanel.Dock="Top" Margin="10,8,10,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Viewbox Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Path Data="{Binding Mark}" Fill="{Binding Accent}" Stretch="Uniform"/>
                    </Viewbox>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Title}"
                                   FontSize="{Binding TitleTextSize}"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap"/>
                        <TextBlock Text="{Binding Headline}"
                                   Margin="0,2,0,0"
                                   FontSize="{Binding DetailTextSize}"
                                   Foreground="{DynamicResource MutedBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap"/>
                    </StackPanel>
                    <Button Grid.Column="2"
                            Content="Fields"
                            Margin="8,0,0,0"
                            Padding="8,2"
                            FontSize="12"
                            VerticalAlignment="Center"
                            Style="{StaticResource PillButton}"
                            AutomationProperties.AutomationId="ScrollFields"
                            ToolTip="Fields on the scrolling results screen. Place and name always show."
                            Click="ScrollFieldsButton_Click"/>
                    <Border Grid.Column="3"
                            Background="{Binding BadgeBrush}"
                            CornerRadius="8"
                            Padding="8,2"
                            VerticalAlignment="Center"
                            Margin="8,0,0,0">
                        <TextBlock Text="{Binding Badge}"
                                   Foreground="White"
                                   FontSize="10"
                                   FontWeight="Bold"/>
                    </Border>
                </Grid>
                <TextBlock DockPanel.Dock="Bottom"
                           Text="{Binding Summary}"
                           Margin="10,4,10,8"
                           FontSize="{Binding DetailTextSize}"
                           Foreground="{DynamicResource MutedBrush}"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap"/>
                <DataGrid ItemsSource="{Binding Rows}"
                          FontSize="{Binding BoardTextSize}"
                          Margin="6,0,6,0"
                          Background="Transparent"
                          BorderThickness="0"
                          VerticalAlignment="Stretch"
                          EnableColumnVirtualization="False"
                          AutoGeneratingColumn="ResultsGrid_AutoGeneratingColumn"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"/>
            </DockPanel>
        </Border>
    </DataTemplate>
</ResourceDictionary>
