<UserControl x:Class="RDS_Results.SettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel MaxWidth="920" HorizontalAlignment="Left">
        <TextBlock Text="Connection" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,10"
                           Text="These values reach the RaceDay Scoring HTTP connector. Results refresh on their own while Automatic is checked."/>
                <WrapPanel>
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="Host" Foreground="{DynamicResource MutedBrush}"/>
                        <TextBox x:Name="HostBox" x:FieldModifier="internal" Width="180" Margin="0,4,0,0" LostFocus="HostBox_LostFocus"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="Port" Foreground="{DynamicResource MutedBrush}"/>
                        <TextBox x:Name="PortBox" x:FieldModifier="internal" Width="80" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="Password" Foreground="{DynamicResource MutedBrush}"/>
                        <TextBox x:Name="PasswordBox" x:FieldModifier="internal" Width="140" Margin="0,4,0,0"
                                 ToolTip="Shared connector password. Mantis currently sends 12345 on this HTTP API."/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="Refresh seconds" Foreground="{DynamicResource MutedBrush}"/>
                        <TextBox x:Name="IntervalBox" x:FieldModifier="internal" Width="110" Margin="0,4,0,0"
                                 ToolTip="How often the background refresh downloads every available report. 2 to 3600."
                                 LostFocus="IntervalBox_LostFocus"/>
                    </StackPanel>
                    <CheckBox x:Name="AutoRefreshBox" x:FieldModifier="internal"
                              Content="Automatic"
                              Margin="0,22,12,8"
                              Checked="AutoRefreshBox_Changed"
                              Unchecked="AutoRefreshBox_Changed"/>
                    <Button x:Name="RefreshButton" x:FieldModifier="internal" Content="Refresh now" Margin="0,18,0,8" Click="RefreshButton_Click"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <TextBlock Text="Appearance" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="LightThemeButton" x:FieldModifier="internal" Style="{StaticResource PillButton}" Click="LightThemeButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE706;" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Light" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="DarkThemeButton" x:FieldModifier="internal" Style="{StaticResource PillButton}" Margin="0" Click="DarkThemeButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE708;" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Dark" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <TextBlock Text="Bib listener" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,10"
                           Text="The hub password opens the announcer socket. It is separate from the HTTP connector password. Choose which timing locations to follow on the Bib reads view."/>
                <WrapPanel>
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="Listen port" Foreground="{DynamicResource MutedBrush}"/>
                        <TextBox x:Name="ListenPortBox" x:FieldModifier="internal" Width="90" Margin="0,4,0,0" LostFocus="ListenSettings_LostFocus"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="Listen password" Foreground="{DynamicResource MutedBrush}"/>
                        <TextBox x:Name="ListenPasswordBox" x:FieldModifier="internal" Width="160" Margin="0,4,0,0"
                                 ToolTip="Hub password set in RaceDay Scoring."
                                 LostFocus="ListenSettings_LostFocus"/>
                    </StackPanel>
                    <CheckBox x:Name="ListenBox" x:FieldModifier="internal"
                              Content="Listen"
                              Margin="0,22,0,8"
                              Checked="ListenBox_Changed"
                              Unchecked="ListenBox_Changed"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <TextBlock Text="Jumbotron" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,10"
                           Text="RDS Results connects out to the jumbotron. The default mode chosen here is saved and returns after a restart. The Results screen can switch the jumbotron for this session only. Welcome is the splash screen. Event welcome sends a custom graphic plus the race name, start, and how to view results. Scrolling results walks each set, men then women."/>
                <TextBlock Text="Default mode" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6"/>
                <WrapPanel x:Name="ModeButtons" x:FieldModifier="internal" Margin="0,0,0,10"/>
                <TextBlock Text="Event welcome graphic" Foreground="{DynamicResource MutedBrush}"/>
                <DockPanel Margin="0,4,0,8">
                    <Button DockPanel.Dock="Right" Content="Clear" Margin="8,0,0,0" Click="ClearEventGraphicButton_Click"/>
                    <Button DockPanel.Dock="Right" Content="Browse" Margin="8,0,0,0" Click="BrowseEventGraphicButton_Click"/>
                    <TextBox x:Name="EventGraphicBox" x:FieldModifier="internal" VerticalContentAlignment="Center"
                             IsReadOnly="True"
                             ToolTip="Background graphic sent to the jumbotron in Event welcome mode."/>
                </DockPanel>
                <WrapPanel>
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="How to view results" Foreground="{DynamicResource MutedBrush}"/>
                        <TextBox x:Name="EventHintBox" x:FieldModifier="internal" Width="320" Margin="0,4,0,0"
                                 ToolTip="Short line on the event welcome screen. A QR code can live in the graphic."
                                 LostFocus="EventWelcome_LostFocus"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="Results URL" Foreground="{DynamicResource MutedBrush}"/>
                        <TextBox x:Name="EventUrlBox" x:FieldModifier="internal" Width="260" Margin="0,4,0,0"
                                 ToolTip="Shown on the event welcome screen. Put a QR code in the graphic if you want one."
                                 LostFocus="EventWelcome_LostFocus"/>
                    </StackPanel>
                </WrapPanel>
                <WrapPanel>
                    <CheckBox x:Name="SendReadsBox" x:FieldModifier="internal"
                              Content="Send to the jumbotron"
                              Margin="0,8,16,8"
                              Checked="SendReadsBox_Changed"
                              Unchecked="SendReadsBox_Changed"/>
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="Jumbotron host" Foreground="{DynamicResource MutedBrush}"/>
                        <TextBox x:Name="JumboHostBox" x:FieldModifier="internal" Width="180" Margin="0,4,0,0"
                                 ToolTip="IP or name of the jumbotron. RDS Results connects out to this address."
                                 LostFocus="SendPortBox_LostFocus"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="Jumbotron port" Foreground="{DynamicResource MutedBrush}"/>
                        <TextBox x:Name="SendPortBox" x:FieldModifier="internal" Width="90" Margin="0,4,0,0"
                                 ToolTip="Port the jumbotron is listening on."
                                 LostFocus="SendPortBox_LostFocus"/>
                    </StackPanel>
                </WrapPanel>
                <TextBlock x:Name="SendStatusText" x:FieldModifier="internal"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource MutedBrush}"/>
            </StackPanel>
        </Border>

        <TextBlock Text="Camera" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,10"
                           Text="These cameras share one RTSP pattern. Enter the camera IP and the URL is built for you. Advanced can set the pattern or a full URL."/>
                <WrapPanel>
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="Camera IP" Foreground="{DynamicResource MutedBrush}"/>
                        <TextBox x:Name="CameraIpBox" x:FieldModifier="internal" Width="180" Margin="0,4,0,0"
                                 ToolTip="Only the IP changes from camera to camera. The RTSP URL is built from the template."
                                 LostFocus="Camera_LostFocus"/>
                    </StackPanel>
                    <CheckBox x:Name="CameraAdvancedBox" x:FieldModifier="internal"
                              Content="Advanced"
                              Margin="0,22,12,8"
                              Checked="CameraAdvanced_Changed"
                              Unchecked="CameraAdvanced_Changed"/>
                </WrapPanel>
                <TextBlock Text="URL" Foreground="{DynamicResource MutedBrush}"/>
                <TextBlock x:Name="CameraBuiltUrlText" x:FieldModifier="internal"
                           Margin="0,4,0,8"
                           FontFamily="Consolas"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource MutedBrush}"
                           Text="Enter a camera IP to build the RTSP URL."/>
                <StackPanel x:Name="CameraAdvancedPanel" x:FieldModifier="internal" Visibility="Collapsed">
                    <TextBlock Text="URL template" Foreground="{DynamicResource MutedBrush}"/>
                    <TextBox x:Name="CameraTemplateBox" x:FieldModifier="internal" Margin="0,4,0,8"
                             ToolTip="Use {ip} where the camera address goes. This is how the URL is built when Exact URL is off."
                             LostFocus="Camera_LostFocus"/>
                    <CheckBox x:Name="CameraExactBox" x:FieldModifier="internal"
                              Content="Use an exact URL"
                              Margin="0,0,0,8"
                              Checked="CameraExact_Changed"
                              Unchecked="CameraExact_Changed"/>
                    <TextBlock Text="Exact URL" Foreground="{DynamicResource MutedBrush}"/>
                    <TextBox x:Name="CameraUrlBox" x:FieldModifier="internal" Margin="0,4,0,0"
                             ToolTip="Full RTSP URL. Used only when Exact URL is checked."
                             LostFocus="Camera_LostFocus"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock Text="Saved lists" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Output folder" Foreground="{DynamicResource MutedBrush}"/>
                <DockPanel Margin="0,4,0,10">
                    <Button DockPanel.Dock="Right" Content="Browse" Margin="8,0,0,0" Click="BrowseButton_Click"/>
                    <TextBox x:Name="OutputFolderBox" x:FieldModifier="internal" VerticalContentAlignment="Center"
                             ToolTip="Folder where Save lists writes the current reports."/>
                </DockPanel>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="SaveButton" x:FieldModifier="internal" Content="Save lists" Margin="0,0,8,0" Click="SaveButton_Click"/>
                    <Button x:Name="OpenFolderButton" x:FieldModifier="internal" Content="Open folder" IsEnabled="False" Click="OpenFolderButton_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock Text="Log" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
            <TextBox x:Name="LogBox" x:FieldModifier="internal"
                     IsReadOnly="True"
                     FontFamily="Consolas"
                     FontSize="12"
                     BorderThickness="0"
                     Background="Transparent"
                     Foreground="{DynamicResource MutedBrush}"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Height="180"/>
        </Border>
    </StackPanel>
</UserControl>
